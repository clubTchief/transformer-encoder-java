<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.math</groupId>
    <artifactId>inner-product-calculator</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- "release" (rather than source/target) also pins the JDK API level and removes the compiler warning -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- One version for every DJL module so they can never drift apart -->
        <djl.version>0.28.0</djl.version>
        <junit.version>5.10.2</junit.version>

        <!-- DEFAULT entry point for `mvn exec:java`. Because it is a property (not a hard-coded
             <configuration>), a command-line -Dexec.mainClass=... overrides it, e.g.
             mvn exec:java -Dexec.mainClass=com.example.story.TrainStoryModel -Dexec.args="corpus=..." -->
        <exec.mainClass>com.example.math.ModernizedHierarchicalEncoderPipeline</exec.mainClass>
    </properties>

    <dependencies>
        <!-- ===== Deep Java Library ===== -->
        <dependency>
            <groupId>ai.djl</groupId>
            <artifactId>api</artifactId>
            <version>${djl.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.djl.pytorch</groupId>
            <artifactId>pytorch-engine</artifactId>
            <version>${djl.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Hugging Face tokenizers / sentence-embedding translator (used by the MiniLM demo pipeline) -->
        <dependency>
            <groupId>ai.djl.huggingface</groupId>
            <artifactId>tokenizers</artifactId>
            <version>${djl.version}</version>
        </dependency>

        <!-- ===== Logging =====
             DJL ships the slf4j 1.7.x API. slf4j-simple 2.x is a provider for the 2.x API, so with it
             you got "Failed to load class StaticLoggerBinder ... NOP logger". 1.7.36 matches. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
        </dependency>

        <!-- ===== Tests =====
             The junit-jupiter aggregate already brings api + engine + params. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.25.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- No <mainClass> here on purpose: it comes from the exec.mainClass property above. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
            </plugin>
        </plugins>
    </build>
</project>
